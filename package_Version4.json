{
  "name": "my-design-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "render": "node src/render.mjs --input src/templates/sample/index.html --out exports/sample --width 1200 --height 628 --formats png,jpeg,pdf --scale 2",
    "render:pdf": "node src/render.mjs --input src/templates/sample/index.html --out exports/sample-a4 --pdf a4",
    "render:py": "python3 src/python/render.py --input src/templates/sample/index.html --out exports/sample-py --width 1200 --height 628 --formats png,jpeg,pdf --scale 2",
    "render:py:pdf": "python3 src/python/render.py --input src/templates/sample/index.html --out exports/sample-py-a4 --pdf a4"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "puppeteer": "^23.7.0"
  },
  "devDependencies": {
    "eslint": "^9.12.0",
    "prettier": "^3.3.3"
  }
}