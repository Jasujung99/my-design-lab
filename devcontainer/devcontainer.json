{
  "name": "My Design Lab (Node+Python)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "postCreateCommand": "set -e && git lfs install && (npm ci || npm install) && npm install @notionhq/client@latest && pip3 install --upgrade pip && pip3 install -r requirements.txt && python3 -m playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "ms-python.python",
        "ms-python.black-formatter"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "python.formatting.provider": "black"
      }
    }
  },
  "remoteUser": "vscode"
}